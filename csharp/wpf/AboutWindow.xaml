<Window x:Class="SteamCheckerWPF.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Über Steam Workshop Checker Pro" Height="360" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#131319" Foreground="#E0E0E0" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header like screenshot: AppName • v1 Pre-release -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" VerticalAlignment="Top">
            <TextBlock Text="SteamChecker" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="  •  " FontSize="18" Foreground="#ffcc00" Margin="4,0"/>
            <TextBlock x:Name="VersionText" Text="" FontSize="16" Foreground="#bbbbbb" VerticalAlignment="Bottom"/>
        </StackPanel>

        <!-- Center content -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,8,0,8">
            <!-- App logo / animation -->
            <Image Source="pack://application:,,,/loading.gif" Width="140" Stretch="Uniform" Margin="0,0,0,8"/>
            <TextBlock HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold">
                <Run Text="made with "/>
                <Run Text="❤" Foreground="#ff6699"/>
                <Run Text=" by iamguexoxo"/>
            </TextBlock>
            <TextBlock HorizontalAlignment="Center" Margin="0,8,0,0">
                <Hyperlink NavigateUri="https://instagram.com/iamgue" RequestNavigate="Hyperlink_RequestNavigate">instagram.com/iamgue</Hyperlink>
            </TextBlock>
        </StackPanel>

        <!-- Footer: Close button -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Schließen" Padding="16,8" Click="Close_Click"
                    Background="#3A3A4F" Foreground="#E0E0E0"/>
        </StackPanel>
    </Grid>
</Window>
